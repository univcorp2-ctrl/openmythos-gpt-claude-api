# Optional auth. Recommended for any public deployment.
OPENMYTHOS_API_KEY=change-me-long-random-token

# Runtime.
OPENMYTHOS_DEVICE=auto
OPENMYTHOS_DTYPE=auto
OPENMYTHOS_MODEL_VARIANT=tiny
OPENMYTHOS_ATTN_TYPE=gqa
OPENMYTHOS_TOKENIZER=openai/gpt-oss-20b

# Optional trained weights.
# OPENMYTHOS_WEIGHTS_PATH=/models/openmythos.pt

# API guardrails.
OPENMYTHOS_MAX_SEQ_LEN=512
OPENMYTHOS_MAX_LOOP_ITERS=4
OPENMYTHOS_MAX_NEW_TOKENS_LIMIT=256
