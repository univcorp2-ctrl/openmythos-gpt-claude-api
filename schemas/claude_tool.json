{
  "name": "generate_with_openmythos",
  "description": "Generate text using an OpenMythos API server. Use this when the user explicitly asks to consult or run OpenMythos.",
  "input_schema": {
    "type": "object",
    "properties": {
      "prompt": {
        "type": "string",
        "description": "Prompt to send to OpenMythos."
      },
      "max_new_tokens": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4096,
        "default": 64
      },
      "n_loops": {
        "type": "integer",
        "minimum": 1,
        "maximum": 128,
        "default": 4
      },
      "temperature": {
        "type": "number",
        "minimum": 0,
        "maximum": 5,
        "default": 0.8
      },
      "top_k": {
        "type": ["integer", "null"],
        "minimum": 1,
        "maximum": 1000,
        "default": 40
      },
      "return_full_text": {
        "type": "boolean",
        "default": false
      }
    },
    "required": ["prompt"]
  }
}
